# Production Dockerfile for API (Node.js)
FROM node:24-alpine AS builder

WORKDIR /app

# Enable pnpm via Corepack (must run after package.json is copied)
RUN corepack enable && corepack prepare pnpm@10.10.0 --activate

# Install dependencies
# Use pnpm install --frozen-lockfile for reproducible, lockfile-driven installs in production
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/client/package.json ./apps/client/
COPY apps/api ./apps/api

# Install dependencies after source is present so workspace links resolve correctly
RUN pnpm install --frozen-lockfile

# Build the NestJS application
RUN pnpm --filter patient-flow-api run build

# Production stage
FROM node:24-alpine AS production

WORKDIR /app

# Copy built application and workspace dependencies
# pnpm isolates dependencies under node_modules/.pnpm and links them into
# each workspace's node_modules. We keep the workspace layout so the symlinks
# remain valid and Node can resolve packages at runtime.
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/drizzle.config.ts ./apps/api/
COPY --from=builder /app/apps/api/tsconfig.json ./apps/api/
COPY --from=builder /app/apps/api/src ./apps/api/src
COPY --from=builder /app/apps/api/drizzle ./apps/api/drizzle
COPY --from=builder /app/node_modules ./node_modules

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001 -G nodejs && \
    chown -R nestjs:nodejs /app

USER nestjs

WORKDIR /app/apps/api

EXPOSE 3000

ENV NODE_ENV=production

CMD ["node", "dist/src/main.js"]