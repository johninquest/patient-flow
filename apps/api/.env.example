# ===========================================
# PATIENT FLOW API ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in the values.
# This file contains server-side secrets and runtime configuration for the NestJS API.
# Never commit the real .env file.

# ---------- DATABASE ----------
# PostgreSQL connection string.
# Local dev (docker-compose.yml): postgresql://pfuser:pfDevPassword@localhost:5432/pfdb
# Docker (docker-compose.test.yml): postgresql://patientflow:patientflow_dev_password@postgres:5432/patientflow
DATABASE_URL=postgresql://pfuser:pfDevPassword@localhost:5432/pfdb

# ---------- AUTHENTICATION ----------
# Secret key for Better Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=your_super_secret_key_here

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---------- URLS ----------
# URLs the API is reachable from (used for CORS and cookie attributes).
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# ---------- ADMIN BOOTSTRAP ----------
# Email of the user to promote to admin on startup.
ADMIN_EMAIL=admin@example.com

# ---------- SERVER ----------
# Port the API listens on (optional, defaults to 3000).
PORT=3000
