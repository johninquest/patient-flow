# Production Dockerfile for Client (static SPA served by nginx)
FROM node:24-alpine AS builder

WORKDIR /app

# Enable pnpm via Corepack (must run after package.json is copied)
RUN corepack enable && corepack prepare pnpm@10.10.0 --activate

# Install dependencies
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/client/package.json ./apps/client/
COPY apps/client ./apps/client

# Install dependencies after source is present so workspace links resolve correctly
RUN pnpm install --frozen-lockfile

# Build the static bundle
RUN pnpm --filter patient-flow-client run build

# Serve stage
FROM nginx:alpine

# Copy built assets from the builder stage
COPY --from=builder /app/apps/client/dist /usr/share/nginx/html

# Traefik routes to port 3000
EXPOSE 3000
RUN sed -i 's/listen 80;/listen 3000;/' /etc/nginx/conf.d/default.conf

CMD ["nginx", "-g", "daemon off;"]
